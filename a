<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
<title>Eatsfood ☕</title>
<style>
  :root {
    --yellow: #FFC400;
    --yellow-2: #FFD800;
    --black: #0b0b0b;
    --panel: #161616;
    --line: #2a2a2a;
    --brown: #6F4E37;
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body { margin: 0; padding: 0; }
  body {
    background: var(--black);
    color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    min-height: 100vh;
  }
  .wrap { max-width: 460px; margin: 0 auto; padding: 0 16px 40px; text-align: center; }

  header {
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    padding: 22px 0 6px; text-align: center;
  }
  .logo {
    width: 46px; height: 46px; border-radius: 12px;
    background: linear-gradient(135deg, var(--yellow) 0%, #e8a800 100%);
    display: flex; align-items: center; justify-content: center;
    font-size: 26px; box-shadow: 0 4px 0 rgba(0,0,0,.35);
  }
  .brand { font-weight: 800; font-size: 22px; letter-spacing: .5px; }
  .brand small { display: block; font-size: 11px; color: #9a9a9a; font-weight: 500; letter-spacing: 2px; text-transform: uppercase; }

  .tabs { display: flex; gap: 8px; margin: 18px 0; }
  .tab {
    flex: 1; padding: 12px 0; border-radius: 14px; border: 1px solid var(--line);
    background: var(--panel); color: #cfcfcf; font-weight: 700; font-size: 15px; cursor: pointer;
    transition: .15s;
  }
  .tab.active { background: var(--yellow); color: #000; border-color: var(--yellow); box-shadow: 0 4px 0 rgba(0,0,0,.3); }

  .card {
    background: var(--panel); border: 1px solid var(--line);
    border-radius: 18px; padding: 20px; margin-bottom: 14px; text-align: center;
  }
  .card h2 { margin: 0 0 4px; font-size: 18px; }
  .card p { margin: 0 0 16px; color: #9a9a9a; font-size: 13.5px; line-height: 1.45; }

  .field { display: flex; flex-direction: column; gap: 10px; max-width: 320px; margin: 0 auto; }
  input[type=text] {
    flex: 1; background: #0e0e0e; border: 1.5px solid var(--line); color: #fff;
    border-radius: 12px; padding: 14px 14px; font-size: 16px; outline: none;
    text-transform: uppercase; letter-spacing: 1px; text-align: center; width: 100%;
  }
  input[type=text]:focus { border-color: var(--yellow); }
  .btn {
    border: none; cursor: pointer; font-weight: 800; border-radius: 12px;
    background: var(--yellow); color: #000; padding: 14px 20px; font-size: 15px; width: 100%;
    box-shadow: 0 4px 0 #b8860b; transition: transform .06s, box-shadow .06s;
  }
  .btn:active { transform: translateY(3px); box-shadow: 0 1px 0 #b8860b; }
  .btn.ghost { background: #222; color: var(--yellow); box-shadow: 0 4px 0 #000; border: 1px solid var(--line); }

  #result { margin-top: 16px; display: none; }
  #result.ok {
    display: block; background: var(--yellow); color: #000; border-radius: 14px;
    padding: 16px; text-align: center; animation: pop .4s ease;
  }
  #result.ok .lbl { font-size: 12px; letter-spacing: 2px; text-transform: uppercase; opacity: .7; font-weight: 700; }
  #result.ok .flag {
    font-size: 22px; font-weight: 900; letter-spacing: 1px; margin-top: 4px;
    word-break: break-all;
  }
  #result.err { display: block; color: #ff6b6b; font-weight: 700; text-align: center; animation: shake .3s; }

  @keyframes pop { 0% { transform: scale(.6); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
  @keyframes shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-6px)} 75%{transform:translateX(6px)} }

  .hud { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; max-width: 340px; margin-left: auto; margin-right: auto; }
  .hud .score { font-weight: 800; font-size: 18px; color: var(--yellow); }
  .hud .lives { font-size: 18px; }
  .stage { position: relative; border-radius: 14px; overflow: hidden; border: 1px solid var(--line); background: #0e0e0e; max-width: 340px; margin: 0 auto; }
  canvas { display: block; width: 100%; touch-action: none; }
  .game-over {
    position: absolute; inset: 0; background: rgba(0,0,0,.78); display: none;
    flex-direction: column; align-items: center; justify-content: center; gap: 10px; text-align: center; padding: 20px;
  }
  .game-over.show { display: flex; }
  .game-over .big { font-size: 26px; font-weight: 900; color: var(--yellow); }
  .game-over .flag-pill {
    background: var(--yellow); color: #000; border-radius: 12px;
    padding: 10px 14px; font-weight: 900; font-size: 17px; letter-spacing: 1px;
    word-break: break-all; max-width: 100%; animation: pop .4s ease;
  }
  .game-over .flag-note { font-size: 13px; color: #cfcfcf; }
  .game-over .flag-note b { color: var(--yellow); word-break: break-all; }
  .hint { font-size: 12px; color: #777; text-align: center; margin-top: 10px; }
  .hidden { display: none; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="logo">☕</div>
    <div class="brand">EATSFOOD<small>Coffee · Mini App</small></div>
  </header>

  <div class="tabs">
    <div class="tab active" id="tabCoupon" onclick="showTab('coupon')">🎟 Купон</div>
    <div class="tab" id="tabGame" onclick="showTab('game')">🎮 Игра</div>
  </div>

  <!-- КУПОН -->
  <div id="view-coupon">
    <div class="card">
      <h2>🎟 Купон на кофе</h2>
      <p>Введи промокод, чтобы получить свой бесплатный кофе и забрать приз.</p>
      <div class="field">
        <input type="text" id="code" placeholder="ВВЕДИ КОД" autocomplete="off" autocapitalize="characters" />
        <button class="btn" id="btnVerify" onclick="verify()">ОК</button>
      </div>
      <div id="result"></div>
    </div>
  </div>

  <!-- ИГРА -->
  <div id="view-game" class="hidden">
    <div class="card">
      <h2>🎮 Лови капли</h2>
      <p>Двигай стаканчик и собирай капли кофе, которые летят сверху. Не пропусти ни одной! Набери <b style="color:var(--yellow)">150 очков</b> — и получишь бонусный флаг 🏁</p>
      <div class="hud">
        <div class="score">☕ <span id="score">0</span></div>
        <div class="lives" id="lives">❤️❤️❤️</div>
      </div>
      <div class="stage">
        <canvas id="game" width="420" height="480"></canvas>
        <div class="game-over" id="over">
          <div class="big">Игра окончена</div>
          <div>Собрано капель: <b id="finalScore">0</b></div>
          <div class="flag-note hidden" id="overFlag">🏁 Поздравляем, ты получил бонусный флаг! Ты можешь сдать его в соответствующем разделе платформы - CyberCamp Side Quest:<br><b id="overFlagText"></b></div>
          <button class="btn" onclick="restart()">Играть снова</button>
        </div>
        <div class="game-over" id="flagModal">
          <div class="big">🏁 150 очков!</div>
          <div class="flag-note">Ты открыл флаг:</div>
          <div class="flag-pill" id="gameFlag"></div>
          <button class="btn" onclick="resumeGame()">Продолжить игру</button>
        </div>
      </div>
      <div class="hint">Управление: свайп / стрелки ← →</div>
    </div>
  </div>
</div>

<script>
// Telegram WebApp (необязательно — работает и в обычном браузере)
try {
  const tw = window.Telegram && window.Telegram.WebApp;
  if (tw) { tw.ready(); tw.expand(); tw.setHeaderColor('#0b0b0b'); tw.setBackgroundColor('#0b0b0b'); }
} catch (e) {}

function showTab(t) {
  document.getElementById('tabCoupon').classList.toggle('active', t === 'coupon');
  document.getElementById('tabGame').classList.toggle('active', t === 'game');
  document.getElementById('view-coupon').classList.toggle('hidden', t !== 'coupon');
  document.getElementById('view-game').classList.toggle('hidden', t !== 'game');
  if (t === 'game') resizeCanvas();
}

/* ---------- Купон (проверка прямо в файле, без сервера) ---------- */
// SHA-256 (компактная реализация, ASCII)
function sha256(ascii) {
  function rightRotate(v, a) { return (v >>> a) | (v << (32 - a)); }
  var mathPow = Math.pow, maxWord = mathPow(2, 32), lengthProperty = 'length', i, j, result = '';
  var words = [], asciiBitLength = ascii[lengthProperty] * 8;
  var hash = sha256.h = sha256.h || [];
  var k = sha256.k = sha256.k || [];
  var primeCounter = k[lengthProperty];
  var isComposite = {};
  for (var candidate = 2; primeCounter < 64; candidate++) {
    if (!isComposite[candidate]) {
      for (i = 0; i < 313; i += candidate) { isComposite[i] = candidate; }
      hash[primeCounter] = (mathPow(candidate, .5) * maxWord) | 0;
      k[primeCounter++] = (mathPow(candidate, 1 / 3) * maxWord) | 0;
    }
  }
  ascii += '\x80';
  while (ascii[lengthProperty] % 64 - 56) ascii += '\x00';
  for (i = 0; i < ascii[lengthProperty]; i++) {
    j = ascii.charCodeAt(i);
    if (j >> 8) return;
    words[i >> 2] |= j << ((3 - i) % 4) * 8;
  }
  words[words[lengthProperty]] = ((asciiBitLength / maxWord) | 0);
  words[words[lengthProperty]] = (asciiBitLength);
  for (j = 0; j < words[lengthProperty];) {
    var w = words.slice(j, j += 16);
    var oldHash = hash;
    hash = hash.slice(0, 8);
    for (i = 0; i < 64; i++) {
      var w15 = w[i - 15], w2 = w[i - 2];
      var a = hash[0], e = hash[4];
      var temp1 = hash[7]
        + (rightRotate(e, 6) ^ rightRotate(e, 11) ^ rightRotate(e, 25))
        + ((e & hash[5]) ^ ((~e) & hash[6]))
        + k[i]
        + (w[i] = (i < 16) ? w[i] : (
          w[i - 16]
          + (rightRotate(w15, 7) ^ rightRotate(w15, 18) ^ (w15 >>> 3))
          + w[i - 7]
          + (rightRotate(w2, 17) ^ rightRotate(w2, 19) ^ (w2 >>> 10))
        ) | 0);
      var temp2 = (rightRotate(a, 2) ^ rightRotate(a, 13) ^ rightRotate(a, 22))
        + ((a & hash[1]) ^ (a & hash[2]) ^ (hash[1] & hash[2]));
      hash = [(temp1 + temp2) | 0].concat(hash);
      hash[4] = (hash[4] + temp1) | 0;
    }
    for (i = 0; i < 8; i++) { hash[i] = (hash[i] + oldHash[i]) | 0; }
  }
  for (i = 0; i < 8; i++) {
    for (j = 3; j + 1; j--) {
      var b = (hash[i] >> (j * 8)) & 255;
      result += ((b < 16) ? 0 : '') + b.toString(16);
    }
  }
  return result;
}

// Соль + хеш купона (сам код в файле не хранится)
var CODE_SALT = "83214a4f0334c0c7d97d93d25cb899d8";
var CODE_HASH = "e2762b5a920b7fc90dc3be119eb5917ee84fa1b77c8134efbb988a1aaac830d2";

// Флаг зашифрован (XOR + base64) — в открытом виде не хранится
function b64ToBytes(b64) { return Uint8Array.from(atob(b64), function (c) { return c.charCodeAt(0); }); }
function decodeFlag() {
  var key = b64ToBytes("mVqYw2N3jKs=");
  var enc = b64ToBytes("yg/IhjFaxO7LFbWALDHK7tw=");
  return String.fromCharCode.apply(null, Array.prototype.map.call(enc, function (c, i) { return c ^ key[i % key.length]; }));
}

async function verify() {
  var input = document.getElementById('code');
  var code = input.value.trim().toUpperCase();
  var result = document.getElementById('result');
  result.className = '';
  result.style.display = 'none';

  if (!code) { showErr('Введи код 😉'); return; }

  var h = sha256(CODE_SALT + code);
  if (h === CODE_HASH) {
    result.className = 'ok';
    result.innerHTML = '<div class="lbl">🎉 Купон активирован! Твой флаг</div><div class="flag">' + decodeFlag() + '</div><div class="secret-link"><a href="https://ag6po0p8tu.hdply.com" target="_blank" style="color:#000;font-size:13px;font-weight:800;margin-top:10px;display:inline-block;text-decoration:underline;text-underline-offset:3px;">АААААА!!! Я забыл пропуск, придется открывать турникет радионяней...</a></div>';
    result.style.display = 'block';
    input.value = '';
  } else {
    showErr('Неверный код, попробуй ещё раз 🙈');
  }
}

function showErr(msg) {
  var result = document.getElementById('result');
  result.className = 'err';
  result.textContent = msg;
  result.style.display = 'block';
}

document.getElementById('code').addEventListener('keydown', function (e) { if (e.key === 'Enter') verify(); });

/* ---------- Игра ---------- */
const cv = document.getElementById('game');
const ctx = cv.getContext('2d');
let W = 420, H = 480;

const YELLOW = '#FFC400', BLACK = '#0b0b0b', BROWN = '#6F4E37', CREAM = '#c89b6f';

let cup = { x: W / 2, w: 96, y: 0 };
let drops = [], score = 0, lives = 3, running = false, raf = null;
let flagShown = false;

/* Флаг за 150 очков (тот же XOR + base64, что и у купона) */
var GAMEFLAG_ENC = "zhvMhjFaz+TfHN2GTjbC77QW0YUm";
function decodeGameFlag() {
  var key = b64ToBytes("mVqYw2N3jKs=");
  var enc = b64ToBytes(GAMEFLAG_ENC);
  return String.fromCharCode.apply(null, Array.prototype.map.call(enc, function (c, i) { return c ^ key[i % key.length]; }));
}
function checkFlag() {
  if (!flagShown && score >= 150) {
    flagShown = true;
    running = false;
    if (raf) cancelAnimationFrame(raf);
    document.getElementById('gameFlag').textContent = decodeGameFlag();
    document.getElementById('flagModal').classList.add('show');
  }
}
function resumeGame() {
  document.getElementById('flagModal').classList.remove('show');
  if (!running) {
    running = true;
    if (raf) cancelAnimationFrame(raf);
    loop();
  }
}
let spawnTimer = 0, spawnEvery = 55, baseSpeed = 2.2, speedMul = 1;
let best = +(localStorage.getItem('eatsfood_best') || 0);

function resizeCanvas() {
  const rect = cv.parentElement.getBoundingClientRect();
  const w = Math.min(420, rect.width - 2);
  cv.width = w; cv.height = Math.round(w * 480 / 420);
  W = cv.width; H = cv.height;
  cup.x = W / 2; cup.y = H - 72;
  if (running) draw();
}

function drawCup() {
  const cx = cup.x, y = cup.y, w = cup.w, h = w * 0.62;
  ctx.save();
  ctx.fillStyle = 'rgba(0,0,0,.35)';
  ctx.beginPath(); ctx.ellipse(cx, H - 12, w * 0.62, 10, 0, 0, Math.PI * 2); ctx.fill();
  ctx.strokeStyle = YELLOW; ctx.lineWidth = w * 0.14;
  ctx.beginPath(); ctx.arc(cx + w * 0.52, y + h * 0.55, w * 0.24, -Math.PI / 2.4, Math.PI / 2.2); ctx.stroke();
  ctx.fillStyle = YELLOW;
  ctx.beginPath();
  ctx.moveTo(cx - w / 2, y);
  ctx.lineTo(cx + w / 2, y);
  ctx.lineTo(cx + w * 0.36, y + h);
  ctx.lineTo(cx - w * 0.36, y + h);
  ctx.closePath(); ctx.fill();
  ctx.fillStyle = '#fff';
  ctx.fillRect(cx - w / 2, y, w, h * 0.16);
  ctx.fillStyle = '#000';
  ctx.fillRect(cx - w / 2, y + h * 0.13, w, h * 0.07);
  ctx.fillStyle = '#000';
  ctx.font = 'bold ' + Math.round(w * 0.16) + 'px sans-serif';
  ctx.textAlign = 'center';
  ctx.fillText('☕', cx, y + h * 0.62);
  ctx.restore();
}

function spawnDrop() {
  drops.push({
    x: 18 + Math.random() * (W - 36),
    y: -20,
    r: 9 + Math.random() * 6,
    v: baseSpeed * (0.85 + Math.random() * 0.4) * speedMul,
    wob: Math.random() * Math.PI * 2
  });
}

function drawDrop(d) {
  ctx.save();
  ctx.globalAlpha = 0.9;
  ctx.fillStyle = BROWN;
  ctx.beginPath(); ctx.arc(d.x, d.y, d.r, 0, Math.PI * 2); ctx.fill();
  ctx.fillStyle = CREAM;
  ctx.beginPath(); ctx.arc(d.x - d.r * 0.3, d.y - d.r * 0.3, d.r * 0.35, 0, Math.PI * 2); ctx.fill();
  ctx.restore();
}

function update() {
  spawnTimer++;
  if (spawnTimer >= spawnEvery) {
    spawnTimer = 0;
    spawnDrop();
    if (Math.random() < 0.35) spawnDrop();
  }

  const cupTop = cup.y;
  const cupL = cup.x - cup.w / 2, cupR = cup.x + cup.w / 2;

  for (let i = drops.length - 1; i >= 0; i--) {
    const d = drops[i];
    d.wob += 0.05;
    d.y += d.v;
    d.x += Math.sin(d.wob) * 0.3;

    if (d.y + d.r >= cupTop && d.y - d.r <= cupTop + 22 && d.x >= cupL && d.x <= cupR) {
      drops.splice(i, 1);
      score++;
      speedMul = 1 + Math.min(score, 60) * 0.02;
      if (score > 0 && score % 10 === 0) spawnEvery = Math.max(22, spawnEvery - 4);
      continue;
    }
    if (d.y - d.r > H) {
      drops.splice(i, 1);
      lives--;
      updateLives();
      if (lives <= 0) return endGame();
    }
  }
  updateScore();
  checkFlag();
}

function updateScore() {
  document.getElementById('score').textContent = score;
}
function updateLives() {
  document.getElementById('lives').textContent = '❤️'.repeat(Math.max(0, lives));
}

function draw() {
  ctx.clearRect(0, 0, W, H);
  const g = ctx.createLinearGradient(0, 0, 0, H);
  g.addColorStop(0, '#141414'); g.addColorStop(1, '#0a0a0a');
  ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
  for (const d of drops) drawDrop(d);
  drawCup();
}

function loop() {
  update();
  draw();
  if (running) raf = requestAnimationFrame(loop);
}

function startGame() {
  drops = []; score = 0; lives = 3; spawnTimer = 0; spawnEvery = 55; speedMul = 1;
  updateScore(); updateLives();
  document.getElementById('over').classList.remove('show');
  running = true;
  if (raf) cancelAnimationFrame(raf);
  loop();
}

function endGame() {
  running = false;
  if (raf) cancelAnimationFrame(raf);
  if (score > best) { best = score; localStorage.setItem('eatsfood_best', String(best)); }
  document.getElementById('finalScore').textContent = score + (score >= best && score > 0 ? ' (рекорд!)' : '');
  document.getElementById('overFlag').classList.toggle('hidden', !flagShown);
  if (flagShown) document.getElementById('overFlagText').textContent = decodeGameFlag();
  document.getElementById('over').classList.add('show');
}
function restart() { startGame(); }

function setCupX(x) {
  const half = cup.w / 2;
  cup.x = Math.max(half, Math.min(W - half, x));
}
cv.addEventListener('pointermove', function (e) {
  const r = cv.getBoundingClientRect();
  setCupX((e.clientX - r.left) * (W / r.width));
});
cv.addEventListener('pointerdown', function (e) {
  if (!running) startGame();
  const r = cv.getBoundingClientRect();
  setCupX((e.clientX - r.left) * (W / r.width));
});
window.addEventListener('keydown', function (e) {
  if (e.key === 'ArrowLeft') setCupX(cup.x - 26);
  if (e.key === 'ArrowRight') setCupX(cup.x + 26);
});

resizeCanvas();
window.addEventListener('resize', resizeCanvas);
startGame();
</script>
